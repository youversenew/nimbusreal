<?xml version="1.0" encoding="utf-8"?>
<UI xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    Title="Mouse Events Demo - Left vs Right Click"
    Width="600" Height="500"
    Background="#1a1a2e">

    <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="0">
        <StackPanel Orientation="Vertical" Margin="20" Spacing="20">
            
            <!-- Title -->
            <Label Text="Mouse Events Demonstration" 
                   FontSize="32" FontWeight="Bold" Foreground="#00d4ff"
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <!-- Description -->
            <Label Text="Left Click: Fires 'onClick' event + 'leftclick' in event system&#10;Right Click: Fires 'onRightClick' event + 'rightclick' in event system"
                   FontSize="14" Foreground="#aaa" 
                   TextWrapping="Wrap" Margin="0,0,0,10"/>

            <!-- Demo Panel 1: Left Click Button -->
            <Card Background="#16213e" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                <StackPanel Orientation="Vertical" Spacing="10">
                    <Label Text="LEFT CLICK DEMO" FontSize="16" FontWeight="Bold" Foreground="#00d4ff"/>
                    
                    <Button Name="leftClickButton" 
                            Background="#0f3460" 
                            Padding="20" 
                            CornerRadius="6"
                            onClick="OnLeftClick"
                            Text="👈 Left Click Here (fires 'onClick' event)"/>

                    <Label Name="leftClickStatus" 
                           Text="Status: Waiting for left click..."
                           FontSize="12" Foreground="#888" Margin="0,5,0,0"/>
                </StackPanel>
            </Card>

            <!-- Demo Panel 2: Right Click Button -->
            <Card Background="#16213e" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                <StackPanel Orientation="Vertical" Spacing="10">
                    <Label Text="RIGHT CLICK DEMO" FontSize="16" FontWeight="Bold" Foreground="#ff6b6b"/>
                    
                    <Button Name="rightClickButton" 
                            Background="#3a0a0a" 
                            Padding="20" 
                            CornerRadius="6"
                            onRightClick="OnRightClick"
                            Text="👉 Right Click Here (fires 'onRightClick' event)"/>

                    <Label Name="rightClickStatus" 
                           Text="Status: Waiting for right click..."
                           FontSize="12" Foreground="#888" Margin="0,5,0,0"/>
                </StackPanel>
            </Card>

            <!-- Demo Panel 3: Both Events on Same Element -->
            <Card Background="#16213e" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                <StackPanel Orientation="Vertical" Spacing="10">
                    <Label Text="DUAL EVENT DEMO" FontSize="16" FontWeight="Bold" Foreground="#51cf66"/>
                    
                    <Button Name="dualClickButton" 
                            Background="#1a4d2e" 
                            Padding="20" 
                            CornerRadius="6"
                            onClick="OnDualLeftClick"
                            onRightClick="OnDualRightClick"
                            Text="↔️ Try Left AND Right Click on This Button"/>

                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <StackPanel Orientation="Vertical">
                                <Label Text="Left Clicks:" FontSize="11" Foreground="#51cf66"/>
                                <Label Name="leftCount" Text="0" FontSize="18" Foreground="#51cf66" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Vertical">
                                <Label Text="Right Clicks:" FontSize="11" Foreground="#ff6b6b"/>
                                <Label Name="rightCount" Text="0" FontSize="18" Foreground="#ff6b6b" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Card>

            <!-- Event Info Panel -->
            <Card Background="#0f3460" CornerRadius="8" Padding="15">
                <StackPanel Orientation="Vertical" Spacing="10">
                    <Label Text="📋 EVENT INFORMATION" FontSize="14" FontWeight="Bold" Foreground="#00d4ff"/>
                    
                    <StackPanel Orientation="Vertical" Spacing="8">
                        <Label Text="Available XML Attributes:" FontSize="12" Foreground="#aaa"/>
                        <Label Text='onClick="HandlerName" - Fires on left click (LMB)'
                               FontSize="11" Foreground="#ddd" Margin="10,0,0,0"/>
                        <Label Text='onRightClick="HandlerName" - Fires on right click (RMB)'
                               FontSize="11" Foreground="#ddd" Margin="10,0,0,0"/>
                        <Label Text="C# Event System: leftclick, rightclick, mousedown, mouseup events"
                               FontSize="11" Foreground="#ddd" Margin="10,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Card>

            <!-- Footer Info -->
            <Label Text="💡 Tip: Right-click on text inputs for context menu (copy, paste, etc.)"
                   FontSize="12" Foreground="#666" 
                   TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>

</UI>
