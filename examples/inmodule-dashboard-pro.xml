<?xml version="1.0" encoding="utf-8"?>
<App Name="Modern Dashboard Pro - inModule Debug Mode"
     Width="1200"
     Height="800"
     Theme="Dark"
     inModule="true">

    <Components>
        <Colors>
            <Color Name="Primary" Value="#007ACC"/>
            <Color Name="Secondary" Value="#0E639C"/>
            <Color Name="Success" Value="#00A551"/>
            <Color Name="Warning" Value="#FF7A00"/>
            <Color Name="Danger" Value="#F44747"/>
            <Color Name="BgDark" Value="#1E1E1E"/>
            <Color Name="BgCard" Value="#2D2D30"/>
            <Color Name="TextPrimary" Value="#FFFFFF"/>
            <Color Name="TextSecondary" Value="#CCCCCC"/>
        </Colors>
    </Components>

    <Logic>
        <Var Name="isLoggedIn" Value="true" Type="bool"/>
        <Var Name="userRole" Value="Admin" Type="string"/>
        <Var Name="notificationCount" Value="5" Type="int"/>
        <Var Name="volumeLevel" Value="75" Type="double"/>
        <Var Name="darkModeEnabled" Value="true" Type="bool"/>
        
        <Handler Name="OnMenuClick">
            <Alert Message="Menu item clicked - Check F12 console for debug info"/>
        </Handler>
        <Handler Name="OnClearLogs">
            <Alert Message="Logs cleared"/>
        </Handler>
    </Logic>

    <UI>
        <!-- MAIN CONTAINER: Header + Content -->
        <FlexPanel Direction="Column" Gap="0" Background="#1E1E1E" Width="1200" Height="800">
            
            <!-- HEADER -->
            <FlexPanel Direction="Row" Gap="16" Height="60" Background="#2D2D30" Padding="16">
                <Label Text="◆ Modern Dashboard Pro" FontSize="20" Foreground="#007ACC" FontWeight="Bold"/>
                <Label Text="✓ inModule Active (F12=Debug)" FontSize="14" Foreground="#00A551"/>
            </FlexPanel>
            
            <!-- MAIN CONTENT -->
            <FlexPanel Direction="Row" Gap="16" Padding="24" Background="#1E1E1E">
                
                <!-- SIDEBAR -->
                <StackPanel Width="200" Background="#2D2D30" Padding="16">
                    <Label Text="NAVIGATION" FontSize="12" Foreground="#0E639C" FontWeight="Bold" Margin="0,0,0,16"/>
                    <Button Text="📊 Dashboard" Width="100%" Height="40" Background="#007ACC" Foreground="#FFFFFF" Margin="0,0,0,8"/>
                    <Button Text="📈 Analytics" Width="100%" Height="40" Background="#3E3E42" Foreground="#CCCCCC" Margin="0,0,0,8"/>
                    <Button Text="👥 Users" Width="100%" Height="40" Background="#3E3E42" Foreground="#CCCCCC" Margin="0,0,0,8"/>
                    <Button Text="⚙ Settings" Width="100%" Height="40" Background="#3E3E42" Foreground="#CCCCCC" Margin="0,0,0,8"/>
                </StackPanel>
                
                <!-- MAIN PANEL: Cards Grid -->
                <StackPanel Background="#1E1E1E">
                    
                    <!-- TITLE -->
                    <Label Text="Dashboard Overview" FontSize="18" Foreground="#FFFFFF" FontWeight="Bold" Margin="0,0,0,16"/>
                    
                    <!-- STATS CARDS -->
                    <FlexPanel Direction="Row" Gap="16" Margin="0,0,0,16">
                        <!-- CARD 1 -->
                        <Card Width="220" Height="120" Padding="16" Background="#2D2D30">
                            <Label Text="Total Users" FontSize="12" Foreground="#0E639C" FontWeight="Bold" Margin="0,0,0,8"/>
                            <Label Text="12,543" FontSize="24" Foreground="#FFFFFF" FontWeight="Bold"/>
                            <ProgressBar Progress="82" ProgressColor="#007ACC"/>
                        </Card>
                        
                        <!-- CARD 2 -->
                        <Card Width="220" Height="120" Padding="16" Background="#2D2D30">
                            <Label Text="Revenue" FontSize="12" Foreground="#00A551" FontWeight="Bold" Margin="0,0,0,8"/>
                            <Label Text="$45,230" FontSize="24" Foreground="#FFFFFF" FontWeight="Bold"/>
                            <ProgressBar Progress="65" ProgressColor="#00A551"/>
                        </Card>
                        
                        <!-- CARD 3 -->
                        <Card Width="220" Height="120" Padding="16" Background="#2D2D30">
                            <Label Text="Active" FontSize="12" Foreground="#FF7A00" FontWeight="Bold" Margin="0,0,0,8"/>
                            <Label Text="8,950" FontSize="24" Foreground="#FFFFFF" FontWeight="Bold"/>
                            <ProgressBar Progress="90" ProgressColor="#FF7A00"/>
                        </Card>
                        
                        <!-- CARD 4 -->
                        <Card Width="220" Height="120" Padding="16" Background="#2D2D30">
                            <Label Text="Alerts" FontSize="12" Foreground="#F44747" FontWeight="Bold" Margin="0,0,0,8"/>
                            <Label Text="23" FontSize="24" Foreground="#FFFFFF" FontWeight="Bold"/>
                            <ProgressBar Progress="45" ProgressColor="#F44747"/>
                        </Card>
                    </FlexPanel>
                    
                    <!-- CONTROLS SECTION -->
                    <Card Padding="20" Background="#2D2D30" Margin="0,0,0,16">
                        <Label Text="Settings and Controls" FontSize="14" Foreground="#FFFFFF" FontWeight="Bold" Margin="0,0,0,12"/>
                        
                        <!-- VOLUME SLIDER -->
                        <FlexPanel Direction="Row" Gap="12" Margin="0,0,0,12">
                            <Label Text="Volume:" FontSize="12" Foreground="#CCCCCC" Width="80"/>
                            <Slider Value="75" Minimum="0" Maximum="100" Width="200" Height="24"/>
                            <Label Text="75%" FontSize="12" Foreground="#CCCCCC"/>
                        </FlexPanel>
                        
                        <!-- TOGGLES -->
                        <FlexPanel Direction="Row" Gap="24" Margin="0,0,0,12">
                            <Toggle IsChecked="true" Label="Notifications"/>
                            <Toggle IsChecked="true" Label="Auto Update"/>
                            <Toggle IsChecked="false" Label="Maintenance Mode"/>
                        </FlexPanel>
                    </Card>
                    
                    <!-- HELP TEXT -->
                    <Card Padding="16" Background="#1E3A3A">
                        <Label Text="🐛 DEBUG MODE ACTIVE" FontSize="12" Foreground="#00FF00" FontWeight="Bold" Margin="0,0,0,8"/>
                        <Label Text="Press F12 to open Developer Console" FontSize="11" Foreground="#CCCCCC" Margin="0,0,0,4"/>
                        <Label Text="• View: Module Tree Structure" FontSize="10" Foreground="#AAAAAA"/>
                        <Label Text="• View: Real-time Debug Logs" FontSize="10" Foreground="#AAAAAA"/>
                        <Label Text="• View: Element Conversions" FontSize="10" Foreground="#AAAAAA"/>
                    </Card>
                    
                </StackPanel>
                
            </FlexPanel>
            
        </FlexPanel>
        
    </UI>
</App>
