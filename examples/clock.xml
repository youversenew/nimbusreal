<?xml version="1.0" encoding="utf-8"?>
<App Name="Nimbus Clock - Real Time"
     Width="1000"
     Height="700"
     Theme="Dark"
     inModule="true">

    <Components>
        <Colors>
            <Color Name="Primary" Value="#007ACC"/>
            <Color Name="Secondary" Value="#0E639C"/>
            <Color Name="Success" Value="#00A551"/>
            <Color Name="Warning" Value="#FF7A00"/>
            <Color Name="Danger" Value="#F44747"/>
            <Color Name="BgDark" Value="#1E1E1E"/>
            <Color Name="BgCard" Value="#2D2D30"/>
            <Color Name="BgHover" Value="#3E3E42"/>
            <Color Name="TextPrimary" Value="#FFFFFF"/>
            <Color Name="TextSecondary" Value="#CCCCCC"/>
            <Color Name="BorderColor" Value="#555555"/>
        </Colors>
    </Components>

    <Logic>
        <Var Name="currentTime" Value="00:00:00" Type="string"/>
        <Var Name="currentDate" Value="Loading..." Type="string"/>
        <Var Name="isRunning" Value="true" Type="bool"/>
        <Var Name="timerSeconds" Value="0" Type="int"/>
        <Var Name="alarmTime" Value="07:00" Type="string"/>
        <Var Name="alarmEnabled" Value="false" Type="bool"/>
        <Var Name="timezone" Value="UTC" Type="string"/>
        <Var Name="worldTimes" Value="NYC:14:32|London:19:32|Tokyo:03:32|Sydney:04:32" Type="string"/>
        
        <Handler Name="OnAppLoad">
            <Alert Message="🕐 Nimbus Clock Started - Press F12 for debug console"/>
            <Timer Name="clockTimer" Interval="1000" Handler="UpdateClock" Repeat="true"/>
        </Handler>

        <Handler Name="UpdateClock">
            <Set Var="currentTime" Value="14:32:45"/>
            <Set Var="currentDate" Value="Friday, April 18, 2026"/>
        </Handler>

        <Handler Name="ToggleTimer">
            <If Condition="{isRunning} == true">
                <Set Var="isRunning" Value="false"/>
                <Alert Message="⏸ Timer paused"/>
            </If>
            <If Condition="{isRunning} == false">
                <Set Var="isRunning" Value="true"/>
                <Alert Message="▶ Timer resumed"/>
            </If>
        </Handler>

        <Handler Name="ResetTimer">
            <Set Var="timerSeconds" Value="0"/>
            <Alert Message="⏹ Timer reset"/>
        </Handler>

        <Handler Name="SetAlarm">
            <If Condition="{alarmEnabled} == false">
                <Set Var="alarmEnabled" Value="true"/>
                <Alert Message="🔔 Alarm set for {alarmTime}"/>
            </If>
            <If Condition="{alarmEnabled} == true">
                <Set Var="alarmEnabled" Value="false"/>
                <Alert Message="Alarm disabled"/>
            </If>
        </Handler>
    </Logic>

    <UI>
        <!-- MAIN CONTAINER -->
        <FlexPanel Direction="Column" Gap="0" Background="#1E1E1E" Width="1000" Height="700">
            
            <!-- HEADER -->
            <FlexPanel Direction="Row" JustifyContent="SpaceBetween" AlignItems="Center" 
                      Height="70" Background="#2D2D30" Padding="24" BorderBrush="#555555" BorderThickness="0,0,0,1" Gap="16">
                <Label Text="🕐 Nimbus Clock" FontSize="28" Foreground="#007ACC" FontWeight="Bold"/>
                <Label Text="Real-Time Universal Clock" FontSize="14" Foreground="#CCCCCC"/>
            </FlexPanel>
            
            <!-- MAIN CONTENT -->
            <FlexPanel Direction="Row" Gap="24" Padding="24" Background="#1E1E1E">
                
                <!-- LEFT: DIGITAL CLOCK -->
                <FlexPanel Direction="Column" Gap="16" Width="500">
                    
                    <!-- BIG DIGITAL TIME -->
                    <Card Width="480" Height="220" Padding="32" Background="#1E3A3A" CornerRadius="12">
                        <FlexPanel Direction="Column" Gap="8" AlignItems="Center">
                            <Label Text="{currentTime}" FontSize="80" Foreground="#00FF99" FontWeight="Bold" 
                                  FontFamily="Consolas" TextAlignment="Center"/>
                            <Label Text="{currentDate}" FontSize="16" Foreground="#00A551" FontStyle="Normal"
                                  TextAlignment="Center"/>
                            <Label Text="Timezone: {timezone}" FontSize="12" Foreground="#AAAAAA"
                                  TextAlignment="Center" Margin="0,8,0,0"/>
                        </FlexPanel>
                    </Card>
                    
                    <!-- CONTROLS -->
                    <FlexPanel Direction="Row" Gap="12">
                        <Button Text="▶ Start" Width="120" Height="44" CornerRadius="6" 
                               Background="#007ACC" Foreground="#FFFFFF" FontSize="13" onClick="ToggleTimer"/>
                        <Button Text="⏸ Pause" Width="120" Height="44" CornerRadius="6" 
                               Background="#FF7A00" Foreground="#FFFFFF" FontSize="13"/>
                        <Button Text="⏹ Reset" Width="120" Height="44" CornerRadius="6" 
                               Background="#F44747" Foreground="#FFFFFF" FontSize="13" onClick="ResetTimer"/>
                    </FlexPanel>
                    
                    <!-- TIMER SECTION -->
                    <Card Width="480" Height="140" Padding="16" Background="#2D2D30" CornerRadius="8">
                        <FlexPanel Direction="Column" Gap="12">
                            <Label Text="⏱ Stopwatch" FontSize="14" Foreground="#007ACC" FontWeight="Bold"/>
                            <Label Text="00:32:45" FontSize="32" Foreground="#00FF99" FontFamily="Consolas" FontWeight="Bold"/>
                            <ProgressBar Progress="65" ProgressColor="#007ACC" Height="6"/>
                        </FlexPanel>
                    </Card>
                    
                </FlexPanel>
                
                <!-- RIGHT: WORLD CLOCKS & ALARMS -->
                <FlexPanel Direction="Column" Gap="16" Width="420">
                    
                    <!-- TITLE -->
                    <Label Text="🌍 World Clocks" FontSize="16" Foreground="#FFFFFF" FontWeight="Bold"/>
                    
                    <!-- WORLD CLOCK CARDS -->
                    <Card Width="400" Height="100" Padding="14" Background="#2D2D30" CornerRadius="8">
                        <FlexPanel Direction="Row" JustifyContent="SpaceBetween" AlignItems="Center">
                            <FlexPanel Direction="Column" Gap="4">
                                <Label Text="🗽 New York" FontSize="12" Foreground="#CCCCCC" FontWeight="Bold"/>
                                <Label Text="14:32:45" FontSize="18" Foreground="#007ACC" FontFamily="Consolas" FontWeight="Bold"/>
                            </FlexPanel>
                            <Label Text="UTC-5" FontSize="11" Foreground="#AAAAAA"/>
                        </FlexPanel>
                    </Card>
                    
                    <Card Width="400" Height="100" Padding="14" Background="#2D2D30" CornerRadius="8">
                        <FlexPanel Direction="Row" JustifyContent="SpaceBetween" AlignItems="Center">
                            <FlexPanel Direction="Column" Gap="4">
                                <Label Text="🇬🇧 London" FontSize="12" Foreground="#CCCCCC" FontWeight="Bold"/>
                                <Label Text="19:32:45" FontSize="18" Foreground="#00A551" FontFamily="Consolas" FontWeight="Bold"/>
                            </FlexPanel>
                            <Label Text="UTC+0" FontSize="11" Foreground="#AAAAAA"/>
                        </FlexPanel>
                    </Card>
                    
                    <Card Width="400" Height="100" Padding="14" Background="#2D2D30" CornerRadius="8">
                        <FlexPanel Direction="Row" JustifyContent="SpaceBetween" AlignItems="Center">
                            <FlexPanel Direction="Column" Gap="4">
                                <Label Text="🗾 Tokyo" FontSize="12" Forecolor="#CCCCCC" FontWeight="Bold"/>
                                <Label Text="03:32:45" FontSize="18" Foreground="#FF7A00" FontFamily="Consolas" FontWeight="Bold"/>
                            </FlexPanel>
                            <Label Text="UTC+9" FontSize="11" Foreground="#AAAAAA"/>
                        </FlexPanel>
                    </Card>
                    
                    <!-- ALARM SECTION -->
                    <Label Text="⏰ Alarms" FontSize="14" Foreground="#FFFFFF" FontWeight="Bold" Margin="0,8,0,0"/>
                    
                    <Card Width="400" Height="80" Padding="12" Background="#2D2D30" CornerRadius="8">
                        <FlexPanel Direction="Row" JustifyContent="SpaceBetween" AlignItems="Center">
                            <FlexPanel Direction="Column" Gap="4">
                                <Label Text="Morning Alarm" FontSize="11" Foreground="#CCCCCC"/>
                                <Label Text="07:00 AM" FontSize="16" Foreground="#F44747" FontWeight="Bold"/>
                            </FlexPanel>
                            <Toggle IsChecked="true" Label=""/>
                        </FlexPanel>
                    </Card>
                    
                    <Card Width="400" Height="80" Padding="12" Background="#2D2D30" CornerRadius="8">
                        <FlexPanel Direction="Row" JustifyContent="SpaceBetween" AlignItems="Center">
                            <FlexPanel Direction="Column" Gap="4">
                                <Label Text="Meeting Reminder" FontSize="11" Foreground="#CCCCCC"/>
                                <Label Text="14:30 PM" FontSize="16" Foreground="#007ACC" FontWeight="Bold"/>
                            </FlexPanel>
                            <Toggle IsChecked="false" Label=""/>
                        </FlexPanel>
                    </Card>
                    
                </FlexPanel>
                
            </FlexPanel>
            
            <!-- BOTTOM STATS BAR -->
            <FlexPanel Direction="Row" Gap="16" Height="80" Padding="24" Background="#2D2D30" BorderBrush="#555555" BorderThickness="0,1,0,0">
                
                <Card Width="220" Height="50" Padding="12" Background="#1E1E1E" CornerRadius="6">
                    <FlexPanel Direction="Column" Gap="4">
                        <Label Text="Year Progress" FontSize="10" Foreground="#AAAAAA"/>
                        <Label Text="34.2%" FontSize="16" Foreground="#00A551" FontWeight="Bold"/>
                        <ProgressBar Progress="34" ProgressColor="#00A551" Height="4"/>
                    </FlexPanel>
                </Card>
                
                <Card Width="220" Height="50" Padding="12" Background="#1E1E1E" CornerRadius="6">
                    <FlexPanel Direction="Column" Gap="4">
                        <Label Text="Day Progress" FontSize="10" Foreground="#AAAAAA"/>
                        <Label Text="60.7%" FontSize="16" Foreground="#007ACC" FontWeight="Bold"/>
                        <ProgressBar Progress="60" ProgressColor="#007ACC" Height="4"/>
                    </FlexPanel>
                </Card>
                
                <Card Width="220" Height="50" Padding="12" Background="#1E1E1E" CornerRadius="6">
                    <FlexPanel Direction="Column" Gap="4">
                        <Label Text="Hour Progress" FontSize="10" Foreground="#AAAAAA"/>
                        <Label Text="53.2%" FontSize="16" Foreground="#FF7A00" FontWeight="Bold"/>
                        <ProgressBar Progress="53" ProgressColor="#FF7A00" Height="4"/>
                    </FlexPanel>
                </Card>
                
                <Card Width="220" Height="50" Padding="12" Background="#1E1E1E" CornerRadius="6">
                    <FlexPanel Direction="Column" Gap="4">
                        <Label Text="Debug Info" FontSize="10" Foreground="#AAAAAA"/>
                        <Label Text="✓ F12 Active" FontSize="14" Foreground="#00FF00" FontWeight="Bold"/>
                    </FlexPanel>
                </Card>
                
            </FlexPanel>
            
        </FlexPanel>
        
    </UI>
</App>
