<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="InModule Example"
    Width="600"
    Height="400"
    Background="#1E1E1E"
    Foreground="#FFFFFF"
    WindowStartupLocation="CenterScreen">
    <Grid Name="mainGrid" Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <StackPanel Name="headerPanel" Orientation="Vertical" Grid.Row="0">
            <Label Name="titleLabel" Content="Custom C# Module UI" FontSize="24" Foreground="#0E639C" />
            <Label Name="descLabel" Content="This UI is created without WPF - pure custom C#" FontSize="12" Foreground="#CCCCCC" />
        </StackPanel>
        <StackPanel Name="contentPanel" Orientation="Vertical" Background="#2D2D30" Grid.Row="1">
            <Label Name="welcomeLabel" Content="Welcome to inModule rendering!" FontSize="16" Foreground="#FFFFFF" />
            <Label Name="statusLabel" Content="Click the button to test interactivity" FontSize="14" Foreground="#CCCCCC" />
        </StackPanel>
        <Button
            Name="actionButton"
            Width="Auto" Height="Auto"
            Margin="0"
            FontSize="14" FontWeight="Normal"
            FontFamily="Segoe UI"
            Foreground="#FFFFFF"
            Cursor="Hand"
            IsEnabled="True">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="#007ACC"
                            CornerRadius="6"
                            BorderBrush="#5D5D5D"
                            BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="ContentArea"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="16,8"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#4D4D4D"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#2D2D2D"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#0078D4"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#2D2D2D"/>
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#3D3D3D"/>
                            <Setter Property="Foreground" Value="#6D6D6D"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>
