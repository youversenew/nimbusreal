<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Modern Dashboard Pro - inModule Debug Mode"
    Width="1200"
    Height="800"
    Background="#1E1E1E"
    Foreground="#FFFFFF"
    WindowStartupLocation="CenterScreen">
    <FlexPanel Direction="Column" Gap="0" Background="#1E1E1E" Width="1200" Height="800">
        <FlexPanel Direction="Row" Gap="16" Height="60" Background="#2D2D30" Padding="16">
            <Label Content="◆ Modern Dashboard Pro" FontSize="20" Foreground="#007ACC" FontWeight="Bold" />
            <Label Content="✓ inModule Active (F12=Debug)" FontSize="14" Foreground="#00A551" />
        </FlexPanel>
        <FlexPanel Direction="Row" Gap="16" Padding="24" Background="#1E1E1E">
            <StackPanel Width="200" Background="#2D2D30" Padding="16">
                <Label Content="NAVIGATION" FontSize="12" Foreground="#0E639C" FontWeight="Bold" Margin="0,0,0,16" />
                <Button
                    Width="100%" Height="40"
                    Margin="0,0,0,8"
                    FontSize="14" FontWeight="Normal"
                    FontFamily="Segoe UI"
                    Foreground="#FFFFFF"
                    Cursor="Hand"
                    IsEnabled="True">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder"
                                    Background="#007ACC"
                                    CornerRadius="6"
                                    BorderBrush="#5D5D5D"
                                    BorderThickness="1"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter x:Name="ContentArea"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="16,8"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#4D4D4D"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#2D2D2D"/>
                                </Trigger>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#0078D4"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#2D2D2D"/>
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#3D3D3D"/>
                                    <Setter Property="Foreground" Value="#6D6D6D"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button
                    Width="100%" Height="40"
                    Margin="0,0,0,8"
                    FontSize="14" FontWeight="Normal"
                    FontFamily="Segoe UI"
                    Foreground="#CCCCCC"
                    Cursor="Hand"
                    IsEnabled="True">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder"
                                    Background="#3E3E42"
                                    CornerRadius="6"
                                    BorderBrush="#5D5D5D"
                                    BorderThickness="1"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter x:Name="ContentArea"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="16,8"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#4D4D4D"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#2D2D2D"/>
                                </Trigger>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#0078D4"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#2D2D2D"/>
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#3D3D3D"/>
                                    <Setter Property="Foreground" Value="#6D6D6D"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button
                    Width="100%" Height="40"
                    Margin="0,0,0,8"
                    FontSize="14" FontWeight="Normal"
                    FontFamily="Segoe UI"
                    Foreground="#CCCCCC"
                    Cursor="Hand"
                    IsEnabled="True">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder"
                                    Background="#3E3E42"
                                    CornerRadius="6"
                                    BorderBrush="#5D5D5D"
                                    BorderThickness="1"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter x:Name="ContentArea"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="16,8"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#4D4D4D"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#2D2D2D"/>
                                </Trigger>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#0078D4"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#2D2D2D"/>
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#3D3D3D"/>
                                    <Setter Property="Foreground" Value="#6D6D6D"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button
                    Width="100%" Height="40"
                    Margin="0,0,0,8"
                    FontSize="14" FontWeight="Normal"
                    FontFamily="Segoe UI"
                    Foreground="#CCCCCC"
                    Cursor="Hand"
                    IsEnabled="True">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder"
                                    Background="#3E3E42"
                                    CornerRadius="6"
                                    BorderBrush="#5D5D5D"
                                    BorderThickness="1"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter x:Name="ContentArea"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="16,8"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#4D4D4D"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#2D2D2D"/>
                                </Trigger>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#0078D4"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#2D2D2D"/>
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#3D3D3D"/>
                                    <Setter Property="Foreground" Value="#6D6D6D"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
            <StackPanel Background="#1E1E1E">
                <Label Content="Dashboard Overview" FontSize="18" Foreground="#FFFFFF" FontWeight="Bold" Margin="0,0,0,16" />
                <FlexPanel Direction="Row" Gap="16" Margin="0,0,0,16">
                    <Border Width="220" Height="120" Padding="16" Background="#2D2D30">
                        <Label Content="Total Users" FontSize="12" Foreground="#0E639C" FontWeight="Bold" Margin="0,0,0,8" />
                        <Label Content="12,543" FontSize="24" Foreground="#FFFFFF" FontWeight="Bold" />
                        <ProgressBar Progress="82" ProgressColor="#007ACC" />
                    </Border>
                    <Border Width="220" Height="120" Padding="16" Background="#2D2D30">
                        <Label Content="Revenue" FontSize="12" Foreground="#00A551" FontWeight="Bold" Margin="0,0,0,8" />
                        <Label Content="$45,230" FontSize="24" Foreground="#FFFFFF" FontWeight="Bold" />
                        <ProgressBar Progress="65" ProgressColor="#00A551" />
                    </Border>
                    <Border Width="220" Height="120" Padding="16" Background="#2D2D30">
                        <Label Content="Active" FontSize="12" Foreground="#FF7A00" FontWeight="Bold" Margin="0,0,0,8" />
                        <Label Content="8,950" FontSize="24" Foreground="#FFFFFF" FontWeight="Bold" />
                        <ProgressBar Progress="90" ProgressColor="#FF7A00" />
                    </Border>
                    <Border Width="220" Height="120" Padding="16" Background="#2D2D30">
                        <Label Content="Alerts" FontSize="12" Foreground="#F44747" FontWeight="Bold" Margin="0,0,0,8" />
                        <Label Content="23" FontSize="24" Foreground="#FFFFFF" FontWeight="Bold" />
                        <ProgressBar Progress="45" ProgressColor="#F44747" />
                    </Border>
                </FlexPanel>
                <Border Padding="20" Background="#2D2D30" Margin="0,0,0,16">
                    <Label Content="Settings and Controls" FontSize="14" Foreground="#FFFFFF" FontWeight="Bold" Margin="0,0,0,12" />
                    <FlexPanel Direction="Row" Gap="12" Margin="0,0,0,12">
                        <Label Content="Volume:" FontSize="12" Foreground="#CCCCCC" Width="80" />
                        <Slider Minimum="0" Maximum="100" Width="200" Height="24" />
                        <Label Content="75%" FontSize="12" Foreground="#CCCCCC" />
                    </FlexPanel>
                    <FlexPanel Direction="Row" Gap="24" Margin="0,0,0,12">
                        <Toggle IsChecked="true" Label="Notifications" />
                        <Toggle IsChecked="true" Label="Auto Update" />
                        <Toggle IsChecked="false" Label="Maintenance Mode" />
                    </FlexPanel>
                </Border>
                <Border Padding="16" Background="#1E3A3A">
                    <Label Content="🐛 DEBUG MODE ACTIVE" FontSize="12" Foreground="#00FF00" FontWeight="Bold" Margin="0,0,0,8" />
                    <Label Content="Press F12 to open Developer Console" FontSize="11" Foreground="#CCCCCC" Margin="0,0,0,4" />
                    <Label Content="• View: Module Tree Structure" FontSize="10" Foreground="#AAAAAA" />
                    <Label Content="• View: Real-time Debug Logs" FontSize="10" Foreground="#AAAAAA" />
                    <Label Content="• View: Element Conversions" FontSize="10" Foreground="#AAAAAA" />
                </Border>
            </StackPanel>
        </FlexPanel>
    </FlexPanel>
</Window>
