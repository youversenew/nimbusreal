<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Nimbus Music"
    Width="1100"
    Height="750"
    Background="#1E1E1E"
    Foreground="#FFFFFF"
    WindowStartupLocation="CenterScreen">
    <Grid Background="#121212">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="90" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#000000" Grid.Row="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="24,28,24,32">
                        <TextBlock Text="🎵" FontSize="28" Margin="0,0,10,0" Foreground="#FFFFFF" />
                        <TextBlock Text="Nimbus Music" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="12,0,12,24">
                        <Border Name="navHome" Background="#282828" CornerRadius="8" Padding="14,12" Margin="0,0,0,4" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏠" FontSize="20" Margin="0,0,14,0" Foreground="#FFFFFF" />
                                <TextBlock Text="Home" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Name="navSearch" Background="Transparent" CornerRadius="8" Padding="14,12" Margin="0,0,0,4" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔍" FontSize="20" Margin="0,0,14,0" Foreground="#FFFFFF" />
                                <TextBlock Text="Search" FontSize="15" FontWeight="SemiBold" Foreground="#B3B3B3" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Name="navLibrary" Background="Transparent" CornerRadius="8" Padding="14,12" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📚" FontSize="20" Margin="0,0,14,0" Foreground="#FFFFFF" />
                                <TextBlock Text="Your Library" FontSize="15" FontWeight="SemiBold" Foreground="#B3B3B3" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden">
                        <StackPanel Margin="12,0,12,0">
                            <Border Height="1" Background="#282828" Margin="0,0,0,16" />
                            <Border Name="btnCreatePlaylist" Background="Transparent" CornerRadius="8" Padding="14,10" Margin="0,0,0,4" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="28" Height="28" CornerRadius="4" Background="#282828">
                                        <TextBlock Text="+" FontSize="18" Foreground="#B3B3B3" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Create Playlist" FontSize="14" Foreground="#B3B3B3" VerticalAlignment="Center" Margin="12,0,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Name="navLiked" Background="Transparent" CornerRadius="8" Padding="14,10" Margin="0,0,0,4" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="28" Height="28" CornerRadius="4">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#7B68EE" Offset="0" />
                                                <GradientStop Color="#B0C4FF" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <TextBlock Text="♥" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Liked Songs" FontSize="14" Foreground="#B3B3B3" VerticalAlignment="Center" Margin="12,0,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Height="1" Background="#282828" Margin="0,8,0,12" />
                            <Border Name="pl1" Padding="14,8" CornerRadius="6" Cursor="Hand">
                                <TextBlock Text="Chill Vibes 🌊" FontSize="13" Foreground="#B3B3B3" />
                            </Border>
                            <Border Name="pl2" Padding="14,8" CornerRadius="6" Cursor="Hand">
                                <TextBlock Text="Workout Mix 💪" FontSize="13" Foreground="#B3B3B3" />
                            </Border>
                            <Border Name="pl3" Padding="14,8" CornerRadius="6" Cursor="Hand">
                                <TextBlock Text="Late Night Jazz 🎷" FontSize="13" Foreground="#B3B3B3" />
                            </Border>
                            <Border Name="pl4" Padding="14,8" CornerRadius="6" Cursor="Hand">
                                <TextBlock Text="Focus Mode 🎯" FontSize="13" Foreground="#B3B3B3" />
                            </Border>
                            <Border Name="pl5" Padding="14,8" CornerRadius="6" Cursor="Hand">
                                <TextBlock Text="Road Trip 🚗" FontSize="13" Foreground="#B3B3B3" />
                            </Border>
                            <Border Name="pl6" Padding="14,8" CornerRadius="6" Cursor="Hand">
                                <TextBlock Text="Uzbek Hits 🇺🇿" FontSize="13" Foreground="#B3B3B3" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Name="btnopenff" Grid.Row="3" Padding="16,12" BorderBrush="#282828" BorderThickness="0,1,0,0">
                        <StackPanel Name="_nimbus_stackpanel_1" Orientation="Horizontal" Cursor="Hand">
                            <TextBlock Text="📁" FontSize="16" Margin="0,0,8,0" Foreground="#FFFFFF" />
                            <TextBlock Text="Open Music Folder" FontSize="12" Foreground="#727272" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <Grid Grid.Column="1" Grid.Row="2">
                <ScrollViewer Name="homeView" Visibility="Visible" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Grid.Row="0">
                    <StackPanel>
                        <Border Margin="0,0,0,0" Height="300">
                            <Border CornerRadius="0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#1DB954" Offset="0" />
                                        <GradientStop Color="#121212" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel Margin="32,48,32,0">
                                    <TextBlock Name="lblGreeting" Text="Good Evening" FontSize="32" FontWeight="Bold" Foreground="White" Margin="0,0,0,28" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="8" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Name="_nimbus_border_2" Grid.Row="0" Grid.Column="0" Background="#343434" CornerRadius="6" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="52" Height="52" CornerRadius="6,0,0,6" Background="#1DB954">
                                                    <TextBlock Text="🎵" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF" />
                                                </Border>
                                                <TextBlock Text="Liked Songs" FontSize="14" FontWeight="Bold" Foreground="White" Margin="14,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <Border Name="_nimbus_border_3" Grid.Row="0" Grid.Column="2" Background="#343434" CornerRadius="6" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="52" Height="52" CornerRadius="6,0,0,6" Background="#E91E63">
                                                    <TextBlock Text="🌊" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF" />
                                                </Border>
                                                <TextBlock Text="Chill Vibes" FontSize="14" FontWeight="Bold" Foreground="White" Margin="14,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <Border Name="_nimbus_border_4" Grid.Row="0" Grid.Column="4" Background="#343434" CornerRadius="6" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="52" Height="52" CornerRadius="6,0,0,6" Background="#FF6F00">
                                                    <TextBlock Text="💪" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF" />
                                                </Border>
                                                <TextBlock Text="Workout" FontSize="14" FontWeight="Bold" Foreground="White" Margin="14,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <Border Name="_nimbus_border_5" Grid.Row="2" Grid.Column="0" Background="#343434" CornerRadius="6" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="52" Height="52" CornerRadius="6,0,0,6" Background="#5C6BC0">
                                                    <TextBlock Text="🎷" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF" />
                                                </Border>
                                                <TextBlock Text="Jazz Night" FontSize="14" FontWeight="Bold" Foreground="White" Margin="14,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <Border Name="_nimbus_border_6" Grid.Row="2" Grid.Column="2" Background="#343434" CornerRadius="6" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="52" Height="52" CornerRadius="6,0,0,6" Background="#00897B">
                                                    <TextBlock Text="🎯" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF" />
                                                </Border>
                                                <TextBlock Text="Focus" FontSize="14" FontWeight="Bold" Foreground="White" Margin="14,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <Border Name="_nimbus_border_7" Grid.Row="2" Grid.Column="4" Background="#343434" CornerRadius="6" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="52" Height="52" CornerRadius="6,0,0,6" Background="#D32F2F">
                                                    <TextBlock Text="🇺🇿" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF" />
                                                </Border>
                                                <TextBlock Text="Uzbek Hits" FontSize="14" FontWeight="Bold" Foreground="White" Margin="14,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Border>
                        <StackPanel Margin="32,8,32,0">
                            <Grid Margin="0,0,0,20">
                                <TextBlock Text="Recently Played" FontSize="24" FontWeight="Bold" Foreground="White" Grid.Row="0" />
                                <TextBlock Text="Show All" FontSize="13" FontWeight="SemiBold" Foreground="#B3B3B3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="Hand" Grid.Row="1" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Name="_nimbus_border_8" Grid.Column="0" Background="#181818" CornerRadius="8" Padding="16" Cursor="Hand" Grid.Row="1">
                                    <StackPanel>
                                        <Border Height="140" CornerRadius="6" Background="#282828" Margin="0,0,0,16">
                                            <TextBlock Text="🎧" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF" />
                                        </Border>
                                        <TextBlock Text="Daily Mix 1" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,6" />
                                        <TextBlock Text="Pop, R&amp;B, Hip-Hop" FontSize="12" Foreground="#727272" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                                <Border Name="_nimbus_border_9" Grid.Column="2" Background="#181818" CornerRadius="8" Padding="16" Cursor="Hand" Grid.Row="2">
                                    <StackPanel>
                                        <Border Height="140" CornerRadius="6" Background="#1A3A2A" Margin="0,0,0,16">
                                            <TextBlock Text="🎸" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF" />
                                        </Border>
                                        <TextBlock Text="Rock Classics" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,6" />
                                        <TextBlock Text="Queen, AC/DC, Nirvana" FontSize="12" Foreground="#727272" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                                <Border Name="_nimbus_border_10" Grid.Column="4" Background="#181818" CornerRadius="8" Padding="16" Cursor="Hand" Grid.Row="3">
                                    <StackPanel>
                                        <Border Height="140" CornerRadius="6" Background="#2A1A3A" Margin="0,0,0,16">
                                            <TextBlock Text="🎹" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF" />
                                        </Border>
                                        <TextBlock Text="Piano Chill" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,6" />
                                        <TextBlock Text="Relax, Classical, Ambient" FontSize="12" Foreground="#727272" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                                <Border Name="_nimbus_border_11" Grid.Column="6" Background="#181818" CornerRadius="8" Padding="16" Cursor="Hand" Grid.Row="4">
                                    <StackPanel>
                                        <Border Height="140" CornerRadius="6" Background="#3A2A1A" Margin="0,0,0,16">
                                            <TextBlock Text="🎤" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF" />
                                        </Border>
                                        <TextBlock Text="Top Hits 2024" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,6" />
                                        <TextBlock Text="Trending Worldwide" FontSize="12" Foreground="#727272" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                                <Border Name="_nimbus_border_12" Grid.Column="8" Background="#181818" CornerRadius="8" Padding="16" Cursor="Hand" Grid.Row="5">
                                    <StackPanel>
                                        <Border Height="140" CornerRadius="6" Background="#1A2A3A" Margin="0,0,0,16">
                                            <TextBlock Text="🎻" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF" />
                                        </Border>
                                        <TextBlock Text="Uzbek Classics" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,6" />
                                        <TextBlock Text="Traditional, Modern" FontSize="12" Foreground="#727272" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                        <StackPanel Margin="32,36,32,0">
                            <TextBlock Text="Made For You" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,20" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#181818" CornerRadius="8" Padding="16" Cursor="Hand" Grid.Row="1">
                                    <StackPanel>
                                        <Border Height="140" CornerRadius="6" Margin="0,0,0,16">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#E91E63" Offset="0" />
                                                    <GradientStop Color="#9C27B0" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="DM" FontSize="36" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Discover Weekly" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,6" />
                                        <TextBlock Text="Your weekly mixtape" FontSize="12" Foreground="#727272" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="#181818" CornerRadius="8" Padding="16" Cursor="Hand" Grid.Row="2">
                                    <StackPanel>
                                        <Border Height="140" CornerRadius="6" Margin="0,0,0,16">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#1DB954" Offset="0" />
                                                    <GradientStop Color="#006400" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="RR" FontSize="36" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Release Radar" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,6" />
                                        <TextBlock Text="New music from artists" FontSize="12" Foreground="#727272" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="4" Background="#181818" CornerRadius="8" Padding="16" Cursor="Hand" Grid.Row="3">
                                    <StackPanel>
                                        <Border Height="140" CornerRadius="6" Background="#FF6F00" Margin="0,0,0,16">
                                            <TextBlock Text="🔥" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF" />
                                        </Border>
                                        <TextBlock Text="On Repeat" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,6" />
                                        <TextBlock Text="Songs you love right now" FontSize="12" Foreground="#727272" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="6" Background="#181818" CornerRadius="8" Padding="16" Cursor="Hand" Grid.Row="4">
                                    <StackPanel>
                                        <Border Height="140" CornerRadius="6" Background="#00695C" Margin="0,0,0,16">
                                            <TextBlock Text="🕐" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF" />
                                        </Border>
                                        <TextBlock Text="Time Capsule" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,6" />
                                        <TextBlock Text="Nostalgic throwbacks" FontSize="12" Foreground="#727272" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="8" Background="#181818" CornerRadius="8" Padding="16" Cursor="Hand" Grid.Row="5">
                                    <StackPanel>
                                        <Border Height="140" CornerRadius="6" Background="#4A148C" Margin="0,0,0,16">
                                            <TextBlock Text="✨" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF" />
                                        </Border>
                                        <TextBlock Text="Blend" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,6" />
                                        <TextBlock Text="Made with friends" FontSize="12" Foreground="#727272" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                        <Border Height="40" />
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer Name="searchView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Grid.Row="1">
                    <StackPanel Margin="32,24,32,40">
                        <TextBlock Text="Search" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,0,0,20" />
                        <Border Name="searchBarBorder" Background="#313131" CornerRadius="8" Height="48" Margin="0,0,0,24" BorderBrush="#474747" BorderThickness="1">
                            <Grid Margin="16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🔍" FontSize="18" Foreground="#B3B3B3" VerticalAlignment="Center" Margin="0,0,12,0" Grid.Row="1" />
                                <Border Width="Auto" Height="Auto"
                                        Margin="0" Background="Transparent">
                                    <TextBox
                                        Name="txtSearch"
                                        FontSize="15"
                                        FontFamily="Segoe UI"
                                        Foreground="White"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        CaretBrush="White"
                                        SelectionBrush="#0078D4"
                                        VerticalContentAlignment="Center"
                                        TextWrapping="NoWrap"
                                        >
                                        <TextBox.Style>
                                            <Style TargetType="{x:Type TextBox}">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type TextBox}">
                                                            <Border x:Name="OuterBorder"
                                                                    Background="Transparent"
                                                                    CornerRadius="6"
                                                                    BorderBrush="#5D5D5D"
                                                                    BorderThickness="0">
                                                                <Grid>
                                                                    <TextBlock x:Name="PlaceholderText"
                                                                               Text="What do you want to listen to?"
                                                                               Foreground="#808080"
                                                                               Margin="10,8"
                                                                               VerticalAlignment="Center"
                                                                               IsHitTestVisible="False"
                                                                               Visibility="Collapsed"/>
                                                                    <ScrollViewer x:Name="PART_ContentHost"
                                                                                  Margin="10,8"
                                                                                  VerticalAlignment="Center"
                                                                                  Focusable="False"/>
                                                                </Grid>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="Text" Value="">
                                                                    <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible"/>
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#7D7D7D"/>
                                                                </Trigger>
                                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                                    <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#0078D4"/>
                                                                </Trigger>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter TargetName="OuterBorder" Property="Background" Value="#252525"/>
                                                                    <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#3D3D3D"/>
                                                                    <Setter Property="Foreground" Value="#6D6D6D"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </Border>
                                <Border Name="btnClearSearch" Grid.Column="2" Cursor="Hand" Visibility="Collapsed" Grid.Row="3">
                                    <TextBlock Text="✕" FontSize="16" Foreground="#B3B3B3" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </Border>
                            </Grid>
                        </Border>
                        <Border Name="searchResultsPanel" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Name="lblSearchResultCount" Text="" FontSize="14" Foreground="#B3B3B3" Margin="0,0,0,16" />
                                <Grid Margin="0,0,0,8" Opacity="0.6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="#" FontSize="13" Foreground="#B3B3B3" HorizontalAlignment="Center" Grid.Row="1" />
                                    <TextBlock Grid.Column="1" Text="TITLE" FontSize="12" FontWeight="SemiBold" Foreground="#B3B3B3" Margin="16,0,0,0" Grid.Row="2" />
                                    <TextBlock Grid.Column="2" Text="ARTIST" FontSize="12" FontWeight="SemiBold" Foreground="#B3B3B3" Width="150" Grid.Row="3" />
                                    <TextBlock Grid.Column="3" Text="⏱" FontSize="14" Foreground="#B3B3B3" HorizontalAlignment="Center" Grid.Row="4" />
                                </Grid>
                                <Border Height="1" Background="#282828" Margin="0,0,0,4" />
                                <StackPanel Name="searchResultsList" />
                                <Border Name="noSearchResults" Visibility="Collapsed" Margin="0,40,0,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="🔍" FontSize="48" TextAlignment="Center" Margin="0,0,0,16" Foreground="#FFFFFF" />
                                        <TextBlock Name="lblNoResults" Text="No results found" FontSize="18" FontWeight="SemiBold" Foreground="White" TextAlignment="Center" />
                                        <TextBlock Text="Try different keywords or check spelling" FontSize="14" Foreground="#727272" TextAlignment="Center" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Name="browseCategoriesPanel" Visibility="Visible">
                            <StackPanel>
                                <TextBlock Text="Browse All" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,0,0,16" />
