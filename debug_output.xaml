<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Component Demo"
    Width="520"
    Height="860"
    Background="#1E1E1E"
    Foreground="#FFFFFF"
    WindowStartupLocation="CenterScreen">
    <Grid Background="#0A0E1A">
        <StackPanel Margin="16" Grid.Row="0">
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" CornerRadius="8" Background="#2D2D2D"
                        BorderBrush="#3D3D3D" BorderThickness="1" Padding="16">
                    <StackPanel>
                        <Border Width="32" Height="32" CornerRadius="6"
                                Background="#314360" HorizontalAlignment="Left">
                            <TextBlock Text="📁" FontSize="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="12" FontSize="22"
                                   FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,10,0,2"/>
                        <TextBlock Text="Loyihalar" FontSize="12" Foreground="#AAAAAA"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" CornerRadius="8" Background="#2D2D2D"
                        BorderBrush="#3D3D3D" BorderThickness="1" Padding="16">
                    <StackPanel>
                        <Border Width="32" Height="32" CornerRadius="6"
                                Background="#453A60" HorizontalAlignment="Left">
                            <TextBlock Text="🧩" FontSize="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="8" FontSize="22"
                                   FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,10,0,2"/>
                        <TextBlock Text="Pluginlar" FontSize="12" Foreground="#AAAAAA"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" CornerRadius="8" Background="#2D2D2D"
                        BorderBrush="#3D3D3D" BorderThickness="1" Padding="16">
                    <StackPanel>
                        <Border Width="32" Height="32" CornerRadius="6"
                                Background="#275143" HorizontalAlignment="Left">
                            <TextBlock Text="✅" FontSize="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="5" FontSize="22"
                                   FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,10,0,2"/>
                        <TextBlock Text="Vazifalar" FontSize="12" Foreground="#AAAAAA"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Border Name="btnNew" CornerRadius="8" Background="#2D2D2D"
                    BorderBrush="#3D3D3D" BorderThickness="1" Padding="14" Margin="0,0,0,6" Cursor="Hand">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8"
                            Background="#314360" VerticalAlignment="Center">
                        <TextBlock Text="🚀" FontSize="18"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="Yangi Loyiha" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                        <TextBlock Text="Bo&apos;sh shablon" FontSize="12" Foreground="#AAAAAA" Margin="0,2,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="›" FontSize="18" Foreground="#808080"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Name="btnOpen" CornerRadius="8" Background="#2D2D2D"
                    BorderBrush="#3D3D3D" BorderThickness="1" Padding="14" Margin="0,0,0,6" Cursor="Hand">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8"
                            Background="#453A60" VerticalAlignment="Center">
                        <TextBlock Text="📂" FontSize="18"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="Faylni Ochish" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                        <TextBlock Text="XML, CS, JSON" FontSize="12" Foreground="#AAAAAA" Margin="0,2,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="›" FontSize="18" Foreground="#808080"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Name="btnDev" CornerRadius="8" Background="#2D2D2D"
                    BorderBrush="#3D3D3D" BorderThickness="1" Padding="14" Margin="0,0,0,6" Cursor="Hand">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8"
                            Background="#245058" VerticalAlignment="Center">
                        <TextBlock Text="🛠️" FontSize="18"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="DevTools" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                        <TextBlock Text="Debug va hot reload" FontSize="12" Foreground="#AAAAAA" Margin="0,2,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="›" FontSize="18" Foreground="#808080"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border CornerRadius="8" Background="#2D2D2D"
                    BorderBrush="#3D3D3D" BorderThickness="1"
                    Padding="20" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Glass Card" FontSize="18" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="Bu avtomatik blur bilan" Foreground="#94A3B8" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Border Width="64" Height="64" CornerRadius="32"
                        Background="#3D3D3D" BorderBrush="#5D5D5D" BorderThickness="1">
                    <TextBlock Text="🧑‍💻" FontSize="29"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border MinWidth="18" Height="18"
                        CornerRadius="9" Background="#EF4444"
                        Padding="4,0" Margin="-12,0,0,0">
                    <TextBlock Text="5" FontSize="10" FontWeight="SemiBold"
                               Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Border Width="12" Height="12"
                        CornerRadius="6" Background="#4CAF50" VerticalAlignment="Center"/>
                <TextBlock Text="  Online" Foreground="#10B981" VerticalAlignment="Center" />
                <Border Width="12" Height="12"
                        CornerRadius="6" Background="#FFC107" Margin="20,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Text="  Away" Foreground="#F59E0B" VerticalAlignment="Center" />
                <Border Width="12" Height="12"
                        CornerRadius="6" Background="#808080" Margin="20,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Text="  Offline" Foreground="#64748B" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
